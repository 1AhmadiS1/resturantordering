# Django
# Generate a unique value for each deployment. Never commit the real value.
SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database
DB_NAME=restaurant_ordering
DB_USER=root
DB_PASSWORD=replace-with-a-strong-local-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Enable these only when production HTTPS is configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
